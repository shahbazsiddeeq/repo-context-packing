# Copy this file to .env and fill in your values
# Only needed if using the API-based completion runner (scripts/run_repoeval_completion_api.py)

STARCODER_API_URL=http://localhost:11434/api/generate
STARCODER_API_KEY=
API_MODEL_NAME=starcoder2:7b
STARCODER_API_FORMAT=openai_completions
STARCODER_API_TIMEOUT_SEC=120
